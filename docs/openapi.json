  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication"
          },
          "403": {
            "description": "Wrong project or origin"
          },
          "404": {
            "description": "Missing or inaccessible resource"
          },
          "429": {
            "description": "Rate limited; Retry-After is 60 seconds"
          },
          "503": {
            "description": "Temporary storage failure; retries must preserve event IDs"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password",
                  "display_name",
                  "organization"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "display_name": {
                    "type": "string"
                  },
                  "organization": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
