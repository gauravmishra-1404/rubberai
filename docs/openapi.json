  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rubberai_session"
      },
      "projectKey": {
        "type": "http",
        "scheme": "bearer"
      },
      "operatorToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Event": {
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "project_id",
          "timestamp"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          },
          "prompt_id": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "tool_name": {
            "type": "string"
          },
          "tool_call_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "commit_sha": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "agent": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "ide": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "model": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "usage": {
            "type": "object",
            "description": "Only on llm.request.completed. Missing fields remain unknown.",
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "cached_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "reasoning_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "cache_write_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              }
            }
          },
          "cost": {
            "type": "object",
            "required": [
              "amount",
              "currency",
              "type"
            ],
            "properties": {
              "amount": {
                "type": "string",
                "pattern": "^[0-9]{1,16}(\\.[0-9]{1,12})?$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "actual",
                  "estimated"
                ]
              },
              "pricing_version": {
                "type": "string"
              }
            }
          },
          "file": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "old_path": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "diff": {
                "type": "string"
              },
              "before_hash": {
                "type": "string"
              },
              "after_hash": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "change_source": {
                "type": "string",
                "enum": [
                  "AI",
                  "HUMAN",
                  "UNKNOWN"
                ]
              },
              "lines_added": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "lines_removed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Retained only in FULL privacy mode."
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "repository_url": {
            "type": "string"
          },
          "privacy": {
            "type": "string",
            "enum": [
              "METADATA_ONLY",
              "REDACTED",
              "FULL"
            ],
            "default": "METADATA_ONLY"
          },
          "track_diffs": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
