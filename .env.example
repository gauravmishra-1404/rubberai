# Replace this local development password. Use a URL-safe value.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
APP_ORIGIN=http://localhost:8080
# Optional operator-only metrics access:
METRICS_TOKEN=
# Optional configured rates; no provider prices are assumed:
# Per-million-token rates, keyed by provider/model. Cache rates are optional, but
# a request reporting cache tokens with no rate for them is left unpriced rather
# than mispriced at the input rate.
# {"anthropic/claude-opus-5":{"input_per_million":"15","output_per_million":"75",
#  "cache_read_per_million":"1.5","cache_write_per_million":"30",
#  "currency":"USD","version":"anthropic-list-2026-09"}}
PRICING_JSON={}
